            storageBucket: "lucky-draw-form.firebasestorage.app",
            messagingSenderId: "223399876928",
            appId: "1:223399876928:web:7b8be629df1f07503542a5",
            measurementId: "G-ZL7K87SMK4"
        };

        const app = initializeApp(firebaseConfig);
        const db = getFirestore(app);

        // Admin PIN (Default: 9569 or 2026)
        const VALID_PINS = ["9569", "2026", "95692"];

        const pinLockScreen = document.getElementById('pin-lock-screen');
        const pinForm = document.getElementById('pin-form');
        const adminPinInput = document.getElementById('admin-pin-input');
        const pinError = document.getElementById('pin-error');
        const lockPanelBtn = document.getElementById('lock-panel-btn');

        let allEntries = [];
        let selectedEntry = null;
        let html5QrScanner = null;

        // 4 Firebase Collections Mapping
        const CATEGORY_COLLECTIONS = [
            { col: "lucky_draw_entries", label: "Normal Customer" },
            { col: "silver_customers", label: "Silver Customer" },
            { col: "gold_customers", label: "Gold Customer" },
            { col: "platinum_customers", label: "Platinum Customer" }
        ];

        // Unlock check
        if (sessionStorage.getItem('savitri_master_unlocked') === 'true') {
            pinLockScreen.classList.add('hidden');
            loadAllCategoriesData();
        }

        pinForm.addEventListener('submit', (e) => {
            e.preventDefault();
            const entered = adminPinInput.value.trim();
            if (VALID_PINS.includes(entered)) {
                sessionStorage.setItem('savitri_master_unlocked', 'true');
                pinLockScreen.classList.add('hidden');
                pinError.classList.add('hidden');
                loadAllCategoriesData();
            } else {
                pinError.classList.remove('hidden');
                adminPinInput.value = '';
            }
        });

        lockPanelBtn.addEventListener('click', () => {
            sessionStorage.removeItem('savitri_master_unlocked');
            pinLockScreen.classList.remove('hidden');
            adminPinInput.value = '';
        });

        function formatDateDDMMYYYY(dateObj) {
            const d = String(dateObj.getDate()).padStart(2, '0');
            const m = String(dateObj.getMonth() + 1).padStart(2, '0');
            const y = dateObj.getFullYear();
            return `${d}/${m}/${y}`;
        }

        function getCategoryBadgeHtml(cat) {
            if (cat === "Silver Customer") return `<span class="cat-badge cb-silver">🥈 SILVER</span>`;
            if (cat === "Gold Customer") return `<span class="cat-badge cb-gold">🥇 GOLD</span>`;
            if (cat === "Platinum Customer") return `<span class="cat-badge cb-platinum">💎 PLATINUM</span>`;
            return `<span class="cat-badge cb-normal">🎟️ NORMAL</span>`;
        }

        function enrichEntry(docSnap, sourceCollection, defaultCategory) {
            const data = docSnap.data();
            const category = data.category || defaultCategory;
            const subDate = data.createdAt
                ? data.createdAt.toDate()
                : (data.clientTimestamp ? new Date(data.clientTimestamp) : new Date());

            const now = new Date();
            const diffDays = (now - subDate) / (1000 * 60 * 60 * 24);
            const isExpired = diffDays > 90;

            const issuedStr = data.formattedDate || formatDateDDMMYYYY(subDate);
            const expDateObj = new Date(subDate.getTime() + 90 * 24 * 60 * 60 * 1000);
            const expiryStr = data.expiryDate || formatDateDDMMYYYY(expDateObj);

            let computedStatus = data.status || "ACTIVE";
            if (computedStatus === "ACTIVE" && isExpired) {
                computedStatus = "EXPIRED";
            }

            return {
                id: docSnap.id,
                sourceCollection,
                category,
                ...data,
                subDate,
                issuedStr,
                expiryStr,
                daysLeft: Math.max(0, Math.ceil(90 - diffDays)),
                computedStatus
            };
        }

        // Load Data from All 4 Collections Simultaneously
        async function loadAllCategoriesData() {
            const tbody = document.getElementById('entries-table-body');
            tbody.innerHTML = `<tr><td colspan="8" style="text-align:center; padding:28px;">⏳ चारों कैटेगरी (Normal, Silver, Gold, Platinum) से डेटा लोड हो रहा है...</td></tr>`;

            try {
                const snapshots = await Promise.all(
                    CATEGORY_COLLECTIONS.map(item => getDocs(collection(db, item.col)))
                );

                const combined = [];
                snapshots.forEach((snap, idx) => {
                    const colInfo = CATEGORY_COLLECTIONS[idx];
                    snap.forEach((docSnap) => {
                        combined.push(enrichEntry(docSnap, colInfo.col, colInfo.label));
                    });
                });

                // Sort newest first
                combined.sort((a, b) => b.subDate - a.subDate);
                allEntries = combined;

                updateMasterCounters();
                renderEntriesTable();
            } catch (error) {
                console.error("Load error:", error);
                tbody.innerHTML = `<tr><td colspan="8" style="text-align:center; color:#dc2626; padding:28px;">❌ डेटा लोड करने में समस्या: ${error.message}</td></tr>`;
            }
        }

        document.getElementById('refresh-data-btn').addEventListener('click', loadAllCategoriesData);

        // Update Top Category Counters & Secondary Stats
        function updateMasterCounters() {
            const totalAll = allEntries.length;
            const totalNormal = allEntries.filter(e => e.category === "Normal Customer").length;
            const totalSilver = allEntries.filter(e => e.category === "Silver Customer").length;
            const totalGold = allEntries.filter(e => e.category === "Gold Customer").length;
            const totalPlatinum = allEntries.filter(e => e.category === "Platinum Customer").length;

            document.getElementById('count-all').textContent = totalAll;
            document.getElementById('count-normal').textContent = totalNormal;
            document.getElementById('count-silver').textContent = totalSilver;
            document.getElementById('count-gold').textContent = totalGold;
            document.getElementById('count-platinum').textContent = totalPlatinum;

            const active = allEntries.filter(e => e.computedStatus === "ACTIVE").length;
            const redeemed = allEntries.filter(e => e.computedStatus === "REDEEMED").length;
            const emi = allEntries.filter(e => (e.paymentMode || '').includes('EMI')).length;
            const winners = allEntries.filter(e => e.isWinner === true).length;

            document.getElementById('stat-active-count').textContent = active;
            document.getElementById('stat-redeemed-count').textContent = redeemed;
            document.getElementById('stat-emi-count').textContent = emi;
            document.getElementById('stat-winner-count').textContent = winners;
        }

        // Clickable Top Category Cards Handler
        window.selectCategoryTab = function(categoryValue) {
            document.getElementById('filter-category').value = categoryValue;

            document.querySelectorAll('.cat-tab-card').forEach(card => {
                if (card.getAttribute('data-cat') === categoryValue) {
                    card.classList.add('active-tab');
                } else {
                    card.classList.remove('active-tab');
                }
            });

            const titleMap = {
                "ALL": "📋 सभी ग्राहक (All Categories - Normal, Silver, Gold, Platinum)",
                "Normal Customer": "🎟️ Normal Customers की लिस्ट",
                "Silver Customer": "🥈 Silver Customers की लिस्ट",
                "Gold Customer": "🥇 Gold Customers की लिस्ट",
                "Platinum Customer": "💎 Platinum Customers की लिस्ट"
            };
            document.getElementById('current-view-title').textContent = titleMap[categoryValue] || titleMap["ALL"];

            renderEntriesTable();
        };

        // WhatsApp Link Builder
        function createWhatsAppLink(entry) {
            const cleanPhone = (entry.mobileNumber || '').replace(/\D/g, '');
            const phoneWithCode = cleanPhone.length === 10 ? `91${cleanPhone}` : cleanPhone;
            const msg = `नमस्ते ${entry.fullName || 'जी'}! 🙏\n*सावित्री इलेक्ट्रॉनिक्स, रुद्रपुर* में आपका स्वागत है।\n\n🎟️ आपका कैश वाउचर कार्ड नं.: *${entry.couponNo || 'SE-2026'}*\n📅 वैधता: *${entry.expiryStr}* तक (90 दिन)\n\n💵 *आपका पक्का लाभ:*\n• ₹10,000+ की खरीदारी पर *₹500 की सीधी छूट*\n• ₹20,000+ की खरीदारी पर *₹1,000 की सीधी छूट*\n• Bajaj Finserv से 0% ब्याज पर आसान EMI उपलब्ध!\n\n📍 पता: रुद्रपुर, गोला वार्ड, मूर्ति नं. 1 के सामने | मो.: 9569242717`;
            return `https://wa.me/${phoneWithCode}?text=${encodeURIComponent(msg)}`;
        }

        // Render Filtered Table
        function renderEntriesTable() {
            const tbody = document.getElementById('entries-table-body');
            const searchVal = document.getElementById('table-search-input').value.trim().toLowerCase();
            const catFilter = document.getElementById('filter-category').value;
            const statusFilter = document.getElementById('filter-status').value;
            const itemFilter = document.getElementById('filter-item').value;
            const payFilter = document.getElementById('filter-payment').value;

            const filtered = allEntries.filter((e) => {
                if (catFilter !== "ALL" && e.category !== catFilter) return false;

                const haystack = `${e.couponNo || ''} ${e.fullName || ''} ${e.mobileNumber || ''} ${e.address || ''} ${e.email || ''} ${e.category || ''}`.toLowerCase();
                if (searchVal && !haystack.includes(searchVal)) return false;

                if (statusFilter === "WINNER") {
                    if (!e.isWinner) return false;
                } else if (statusFilter !== "ALL" && e.computedStatus !== statusFilter) {
                    return false;
                }

                if (itemFilter !== "ALL") {
                    const itemsStr = Array.isArray(e.itemsNeeded) ? e.itemsNeeded.join(' ') : '';
                    if (!itemsStr.toLowerCase().includes(itemFilter.toLowerCase())) return false;
                }

                if (payFilter !== "ALL") {
                    if (!(e.paymentMode || '').toLowerCase().includes(payFilter.toLowerCase())) return false;
                }

                return true;
            });

            document.getElementById('filtered-count-badge').textContent = `${filtered.length} ग्राहक`;

            if (filtered.length === 0) {
                tbody.innerHTML = `<tr><td colspan="8" style="text-align:center; padding:28px; color:#64748b; font-weight:600;">इस फिल्टर में कोई ग्राहक डेटा नहीं मिला।</td></tr>`;
                return;
            }

            tbody.innerHTML = filtered.map((e) => {
                let statusBadge = `<span class="badge-status st-active">ACTIVE (${e.daysLeft}d)</span>`;
                if (e.computedStatus === "REDEEMED") {
                    statusBadge = `<span class="badge-status st-redeemed">REDEEMED (${e.redeemedTier || 'Used'})</span>`;
                } else if (e.computedStatus === "EXPIRED") {
                    statusBadge = `<span class="badge-status st-expired">EXPIRED</span>`;
                }

                const winnerBadge = e.isWinner
                    ? `<div style="margin-top:4px;"><span class="badge-status st-winner">🏆 ${e.wonPrize || 'Winner'}</span></div>`
                    : '';

                const itemsHtml = (Array.isArray(e.itemsNeeded) && e.itemsNeeded.length > 0)
                    ? e.itemsNeeded.map(i => `<span class="item-chip">${i}</span>`).join('')
                    : `<span style="color:#94a3b8; font-size:0.74rem;">-</span>`;

                const waUrl = createWhatsAppLink(e);

                return `
                    <tr>
                        <td>${getCategoryBadgeHtml(e.category)}</td>
                        <td>
                            <span class="serial-badge">${e.couponNo || 'SE-2026/N-A'}</span>
                            <div style="font-size:0.66rem; color:#64748b; margin-top:2px;">📅 ${e.issuedStr}</div>
                        </td>
                        <td>
                            ${statusBadge}
                            ${winnerBadge}
                            <div style="font-size:0.65rem; color:#64748b; margin-top:2px;">वैध: ${e.expiryStr}</div>
                        </td>
                        <td>
                            <div style="font-weight:800; color:#0f172a;">${e.fullName || '-'}</div>
                            <div style="font-weight:700; color:#b91c1c; font-size:0.78rem;">📱 ${e.mobileNumber || '-'}</div>
                        </td>
                        <td><div style="font-weight:600;">${e.address || '-'}</div></td>
                        <td>${itemsHtml}</td>
                        <td>
                            <div style="font-weight:700; color:#0369a1; font-size:0.75rem;">${e.paymentMode || '-'}</div>
                            ${e.occasionDate ? `<div style="font-size:0.68rem; color:#9a3412;">🎉 ${e.occasionDate}</div>` : ''}
                        </td>
                        <td>
                            <div class="row-btns">
                                <button type="button" class="btn-sm btn-view" onclick="window.openEntryModal('${e.id}', '${e.sourceCollection}')">
                                    🔍 Verify / छूट
                                </button>
                                <a href="${waUrl}" target="_blank" class="btn-sm btn-wa">💬 WA</a>
                                <button type="button" class="btn-sm btn-del" onclick="window.deleteCustomerEntry('${e.id}', '${e.sourceCollection}')">🗑️</button>
                            </div>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        // Sync Dropdown Filter with Top Tabs
        document.getElementById('filter-category').addEventListener('change', (e) => {
            window.selectCategoryTab(e.target.value);
        });
        document.getElementById('table-search-input').addEventListener('input', renderEntriesTable);
        document.getElementById('filter-status').addEventListener('change', renderEntriesTable);
        document.getElementById('filter-item').addEventListener('change', renderEntriesTable);
        document.getElementById('filter-payment').addEventListener('change', renderEntriesTable);

        // ================= VERIFICATION & REDEMPTION MODAL =================
        const verifyModal = document.getElementById('verify-modal');
        const closeModalBtn = document.getElementById('close-modal-btn');

        window.openEntryModal = function(docId, sourceCol) {
            const entry = allEntries.find(item => item.id === docId && (!sourceCol || item.sourceCollection === sourceCol));
            if (!entry) return;
            selectedEntry = entry;

            document.getElementById('modal-coupon-no').textContent = `कूपन क्र.: ${entry.couponNo || 'SE-2026'}`;
            document.getElementById('m-category').innerHTML = getCategoryBadgeHtml(entry.category);
            document.getElementById('m-name').textContent = entry.fullName || '-';
            document.getElementById('m-mobile').textContent = entry.mobileNumber || '-';
            document.getElementById('m-address').textContent = entry.address || '-';
            document.getElementById('m-email').textContent = entry.email || '-';
            document.getElementById('m-issued').textContent = entry.issuedStr;
            document.getElementById('m-expiry').textContent = `${entry.expiryStr} (${entry.daysLeft} दिन शेष)`;
            document.getElementById('m-payment').textContent = `${entry.paymentMode || '-'} ${entry.occasionDate ? '(' + entry.occasionDate + ')' : ''}`;
            document.getElementById('m-items').textContent = (Array.isArray(entry.itemsNeeded) && entry.itemsNeeded.length > 0)
                ? entry.itemsNeeded.join(', ')
                : 'सभी इलेक्ट्रॉनिक्स सामान';

            const statusBanner = document.getElementById('modal-status-banner');
            const redeemBtns = document.getElementById('redeem-action-buttons');
            const alreadyRedeemedBox = document.getElementById('already-redeemed-box');

            if (entry.computedStatus === "REDEEMED") {
                statusBanner.style.background = "#ffedd5";
                statusBanner.style.color = "#9a3412";
                statusBanner.innerHTML = `⚠️ यह कूपन पहले ही रिडीम (Used) हो चुका है!`;
                redeemBtns.classList.add('hidden');
                alreadyRedeemedBox.classList.remove('hidden');
                document.getElementById('redeemed-info-text').textContent =
                    `छूट दी गई: ${entry.redeemedTier || 'Discount Used'} (दिनांक: ${entry.redeemedDate || '-'})`;
            } else if (entry.computedStatus === "EXPIRED") {
                statusBanner.style.background = "#fee2e2";
                statusBanner.style.color = "#991b1b";
                statusBanner.innerHTML = `❌ इस कूपन की 90 दिनों की वैधता समाप्त हो चुकी है!`;
                redeemBtns.classList.remove('hidden');
                alreadyRedeemedBox.classList.add('hidden');
            } else {
                statusBanner.style.background = "#dcfce7";
                statusBanner.style.color = "#166534";
                statusBanner.innerHTML = `✅ कूपन मान्य (VALID) है! (${entry.daysLeft} दिन बाकी)`;
                redeemBtns.classList.remove('hidden');
                alreadyRedeemedBox.classList.add('hidden');
            }

            document.getElementById('m-call-link').href = `tel:${entry.mobileNumber || ''}`;
            document.getElementById('m-wa-link').href = createWhatsAppLink(entry);

            verifyModal.classList.remove('hidden');
        };

        closeModalBtn.addEventListener('click', () => {
            verifyModal.classList.add('hidden');
        });

        async function markCouponRedeemed(discountTierText) {
            if (!selectedEntry) return;
            try {
                const nowStr = formatDateDDMMYYYY(new Date());
                const docRef = doc(db, selectedEntry.sourceCollection, selectedEntry.id);
                await updateDoc(docRef, {
                    status: "REDEEMED",
                    redeemedTier: discountTierText,
                    redeemedDate: nowStr
                });
                alert(`🎉 कूपन ${selectedEntry.couponNo} (${selectedEntry.category}) पर "${discountTierText}" लागू हो गया!`);
                verifyModal.classList.add('hidden');
                await loadAllCategoriesData();
            } catch (error) {
                alert("अपडेट में समस्या: " + error.message);
            }
        }

        document.getElementById('btn-redeem-500').addEventListener('click', () => {
            markCouponRedeemed("₹500 OFF (₹10k+ Purchase)");
        });

        document.getElementById('btn-redeem-1000').addEventListener('click', () => {
            markCouponRedeemed("₹1,000 OFF (₹20k+ Purchase)");
        });

        document.getElementById('btn-reactivate-coupon').addEventListener('click', async () => {
            if (!selectedEntry) return;
            try {
                const docRef = doc(db, selectedEntry.sourceCollection, selectedEntry.id);
                await updateDoc(docRef, {
                    status: "ACTIVE",
                    redeemedTier: null,
                    redeemedDate: null
                });
                verifyModal.classList.add('hidden');
                await loadAllCategoriesData();
            } catch (error) {
                alert("री-एक्टिवेट करने में समस्या: " + error.message);
            }
        });

        window.deleteCustomerEntry = async function(docId, sourceCol) {
            const entry = allEntries.find(e => e.id === docId && e.sourceCollection === sourceCol);
            if (!entry) return;
            if (!confirm(`क्या आप वाकई "${entry.fullName}" (${entry.category} - ${entry.couponNo}) को डिलीट करना चाहते हैं?`)) return;

            try {
                await deleteDoc(doc(db, entry.sourceCollection, docId));
                await loadAllCategoriesData();
            } catch (error) {
                alert("डिलीट करने में समस्या: " + error.message);
            }
        };

        // ================= QR SCANNER & MANUAL SERIAL LOOKUP =================
        function findAndOpenByQueryText(rawText) {
            if (!rawText) return;
            const cleaned = rawText.trim();
            let serialMatch = cleaned.match(/SE-\d{4}\/\d+/i);
            let searchKey = serialMatch ? serialMatch[0].toUpperCase() : cleaned.toUpperCase();

            const found = allEntries.find(e => {
                const cNo = (e.couponNo || '').toUpperCase();
                const mob = (e.mobileNumber || '');
                return cNo === searchKey || cNo.endsWith(searchKey) || mob === searchKey;
            });

            if (found) {
                window.openEntryModal(found.id, found.sourceCollection);
            } else {
                alert(`❌ "${searchKey}" नंबर का कोई कूपन किसी भी कैटेगरी में नहीं मिला!`);
            }
        }

        document.getElementById('manual-verify-form').addEventListener('submit', (e) => {
            e.preventDefault();
            findAndOpenByQueryText(document.getElementById('manual-serial-input').value);
        });

        const startCameraBtn = document.getElementById('start-camera-btn');
        const stopCameraBtn = document.getElementById('stop-camera-btn');
        const qrReaderDiv = document.getElementById('qr-reader');

        async function startQrScanner() {
            qrReaderDiv.classList.remove('hidden');
            startCameraBtn.classList.add('hidden');
            stopCameraBtn.classList.remove('hidden');

            if (!html5QrScanner) {
                html5QrScanner = new Html5Qrcode("qr-reader");
            }

            try {
                await html5QrScanner.start(
                    { facingMode: "environment" },
                    { fps: 10, qrbox: { width: 220, height: 220 } },
                    (decodedText) => {
                        stopQrScanner();
                        findAndOpenByQueryText(decodedText);
                    },
                    () => {}
                );
            } catch (err) {
                alert("कैमरा चालू करने की अनुमति दें: " + err);
                stopQrScanner();
            }
        }

        async function stopQrScanner() {
            if (html5QrScanner && html5QrScanner.isScanning) {
                try { await html5QrScanner.stop(); } catch (e) {}
            }
            qrReaderDiv.classList.add('hidden');
            startCameraBtn.classList.remove('hidden');
            stopCameraBtn.classList.add('hidden');
        }

        startCameraBtn.addEventListener('click', startQrScanner);
        stopCameraBtn.addEventListener('click', stopQrScanner);
        document.getElementById('top-scan-btn').addEventListener('click', () => {
            document.getElementById('scanner-panel').scrollIntoView({ behavior: 'smooth' });
            startQrScanner();
        });

        // ================= CATEGORY-AWARE LUCKY DRAW WINNER PICKER =================
        const spinWinnerBtn = document.getElementById('spin-winner-btn');
        const rollerSerial = document.getElementById('roller-serial');
        const rollerName = document.getElementById('roller-name');

        spinWinnerBtn.addEventListener('click', async () => {
            const drawCat = document.getElementById('draw-category-select').value;
            const selectedPrize = document.getElementById('prize-select').value;

            const eligible = allEntries.filter(e => {
                if (e.isWinner) return false;
                if (drawCat !== "ALL" && e.category !== drawCat) return false;
                return true;
            });

            if (eligible.length === 0) {
                alert("इस कैटेगरी में लकी ड्रॉ के लिए कोई ग्राहक उपलब्ध नहीं है!");
                return;
            }

            spinWinnerBtn.disabled = true;
            let counter = 0;
            const totalSpins = 22;

            const interval = setInterval(async () => {
                const rand = eligible[Math.floor(Math.random() * eligible.length)];
                rollerSerial.textContent = rand.couponNo || 'SE-2026/00000';
                rollerName.textContent = `${rand.fullName} [${rand.category}]`;
                counter++;

                if (counter >= totalSpins) {
                    clearInterval(interval);
                    const winner = eligible[Math.floor(Math.random() * eligible.length)];
                    rollerSerial.textContent = `🏆 ${winner.couponNo}`;
                    rollerName.textContent = `विजेता: ${winner.fullName} (${winner.category}) | इनाम: ${selectedPrize}`;

                    if (typeof confetti === 'function') {
                        confetti({ particleCount: 90, spread: 80, origin: { y: 0.6 } });
                    }

                    try {
                        await updateDoc(doc(db, winner.sourceCollection, winner.id), {
                            isWinner: true,
                            wonPrize: selectedPrize,
                            wonDate: formatDateDDMMYYYY(new Date())
                        });
                        await loadAllCategoriesData();
                        setTimeout(() => {
                            window.openEntryModal(winner.id, winner.sourceCollection);
                        }, 900);
                    } catch (e) {
                        console.error(e);
                    }
                    spinWinnerBtn.disabled = false;
                }
            }, 90);
        });

        // ================= CATEGORY-WISE EXCEL (CSV) DOWNLOAD =================
        window.exportCategoryCSV = function(targetCategory) {
            const listToExport = targetCategory === "ALL"
                ? allEntries
                : allEntries.filter(e => e.category === targetCategory);

            if (listToExport.length === 0) {
                alert(`"${targetCategory}" कैटेगरी में डाउनलोड करने के लिए कोई डेटा नहीं है!`);
                return;
            }

            const headers = [
                "Category",
                "Coupon_No",
                "Issued_Date",
                "Expiry_Date",
                "Status",
                "Customer_Name",
                "Mobile_Number",
                "Address_Ward",
                "Email",
                "Items_Needed",
                "Payment_Mode",
                "Occasion_Date",
                "Redeemed_Discount",
                "Lucky_Draw_Prize"
            ];

            const rows = listToExport.map(e => [
                `"${e.category || 'Normal Customer'}"`,
                `"${e.couponNo || ''}"`,
                `"${e.issuedStr || ''}"`,
                `"${e.expiryStr || ''}"`,
                `"${e.computedStatus || ''}"`,
                `"${(e.fullName || '').replace(/"/g, '""')}"`,
                `"${e.mobileNumber || ''}"`,
                `"${(e.address || '').replace(/"/g, '""')}"`,
                `"${e.email || ''}"`,
                `"${(Array.isArray(e.itemsNeeded) ? e.itemsNeeded.join(' | ') : '').replace(/"/g, '""')}"`,
                `"${e.paymentMode || ''}"`,
                `"${e.occasionDate || ''}"`,
                `"${e.redeemedTier || ''}"`,
                `"${e.wonPrize || ''}"`
            ]);

            const csvContent = "\uFEFF" + [headers.join(","), ...rows.map(r => r.join(","))].join("\n");
            const blob = new Blob([csvContent], { type: "text/csv;charset=utf-8;" });
            const url = URL.createObjectURL(blob);
            const link = document.createElement("a");
            const safeCatName = targetCategory.replace(/\s+/g, '_');
            link.href = url;
            link.download = `Savitri_Electronics_${safeCatName}_${formatDateDDMMYYYY(new Date()).replace(/\//g, '-')}.csv`;
            link.click();
        };
    </script>
</body>
</html>

